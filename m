> > > 0x0000555555566bd0 <spawn_mount+832>:	pop    %rbx
> > > 0x0000555555566bd1 <spawn_mount+833>:	pop    %r12
> > > 0x0000555555566bd3 <spawn_mount+835>:	pop    %r13
> > > 0x0000555555566bd5 <spawn_mount+837>:	pop    %r14
